# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo

# claude code / playwright runtime — everything under .claude/ is either
# runtime state (scheduled_tasks.lock), per-user settings, or installed
# skills. None of it belongs in the repo.
.playwright-mcp/
.claude/
skills-lock.json

# next-sitemap generated artefacts (rebuilt by `yarn build`)
/public/sitemap.xml
/public/sitemap-*.xml
/public/robots.txt.lock

# playwright runtime
/test-results/
/playwright-report/

# lighthouse JSON dumps — run-by-run artifacts, 600KB+ each
/docs/audits/

# Local-only WIP / exploration pages. Files placed under pages/wip/ route
# normally in `yarn dev` (localhost:3000/wip/*) but are never tracked, never
# deployed. Use for variant comparisons, button explorations, etc. Promote
# anything you want to keep into the real codebase via a regular commit.
/pages/wip/

# transient debug screenshots at repo root (real assets live in /public/images/)
/*.png
